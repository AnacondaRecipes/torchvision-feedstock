From 3cb23858de120e80ea3c2e05a64c519dbaa415c0 Mon Sep 17 00:00:00 2001
From: Mark Harfouche <mark.harfouche@gmail.com>
Date: Sun, 3 Nov 2024 22:01:57 -0500
Subject: [PATCH 1/3] Use system giflib

---
 setup.py                                     | 3 ++-
 torchvision/csrc/io/image/cpu/decode_gif.cpp | 2 +-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/setup.py b/setup.py
index 657d15c..3744e46 100644
--- a/setup.py
+++ b/setup.py
@@ -321,10 +321,11 @@ def make_image_stable_extension():
     sources = (
         list(image_dir.glob("*.cpp"))
         + list(image_dir.glob("cpu/*.cpp"))
-        + list(image_dir.glob("cpu/giflib/*.c"))
         + list(image_dir.glob("cuda/*.cpp"))
     )
 
+    libraries.append("gif")
+
     Extension = CppExtension
 
     if USE_PNG:
diff --git a/torchvision/csrc/io/image/cpu/decode_gif.cpp b/torchvision/csrc/io/image/cpu/decode_gif.cpp
index 4e21fb6..3252b11 100644
--- a/torchvision/csrc/io/image/cpu/decode_gif.cpp
+++ b/torchvision/csrc/io/image/cpu/decode_gif.cpp
@@ -9,7 +9,7 @@
 #include <cstring>
 
 #include "../common_stable.h"
-#include "giflib/gif_lib.h"
+#include <gif_lib.h>
 
 namespace vision {
 namespace image {
